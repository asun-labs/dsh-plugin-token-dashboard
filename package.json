{
  "name": "@asun-labs/dsh-plugin-token-dashboard",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that generates a self-contained token usage dashboard from persisted sessions",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "prepublishOnly": "pnpm run check",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asun-labs/dsh-plugin-token-dashboard.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/asun-labs/dsh-plugin-token-dashboard#readme",
  "bugs": "https://github.com/asun-labs/dsh-plugin-token-dashboard/issues",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "cordis",
    "token",
    "dashboard"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-query": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
